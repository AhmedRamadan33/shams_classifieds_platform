APP_NAME=shams
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shams
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# "file" by default; Redis is supported through .env only (CACHE_STORE=redis, QUEUE_CONNECTION=redis)
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Classifieds platform (see config/classifieds.php) ---
CLASSIFIEDS_PHONE_COUNTRY_CODE=+20
CLASSIFIEDS_CURRENCY_LABEL="ج.م"
CLASSIFIEDS_CURRENCY_CODE=EGP
CLASSIFIEDS_LISTING_DURATION_DAYS=30
CLASSIFIEDS_REQUIRE_REVIEW=true
CLASSIFIEDS_DAILY_LISTING_LIMIT=10
# Shown on the «اتصل بنا» page (only used when the page is first seeded) and checked by launch:check.
CLASSIFIEDS_CONTACT_EMAIL=support@example.com
# Extra blocked words/phrases, comma separated (a default Arabic list is built in).
# CLASSIFIEDS_BLOCKED_WORDS=

# SMS gateway for OTP codes: log (writes to storage/logs, local development only), twilio or vonage.
SMS_DRIVER=log
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# VONAGE_KEY=
# VONAGE_SECRET=
# VONAGE_FROM=Shams

# Administrator created by AdminSeeder. Change the password before deploying.
ADMIN_NAME="مدير الموقع"
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=change-me-please

# --- Backups (spatie/laravel-backup: database dump + uploaded images, daily at 02:00) ---
# BACKUP_DISK=local
# BACKUP_NOTIFICATION_EMAIL=admin@your-domain.com
# Path to the folder containing mysqldump when it is not on PATH:
# DB_DUMP_BINARY_PATH=

# --- Featured-ad payments (packages managed in the admin panel) ---
# "fake" settles every payment instantly: local development and testing only.
PAYMENT_DRIVER=fake
# PAYMENT_DRIVER=paymob
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# --- WhatsApp copies of notifications (opt-in per user in their profile) ---
# "log" writes them to storage/logs (local development only).
WHATSAPP_DRIVER=log
# WHATSAPP_DRIVER=cloud
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# --- Optional integrations ---
# CAPTCHA_DRIVER=turnstile   (null = honeypot + rate limits only)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_FAIL_OPEN=true
# SENTRY_LARAVEL_DSN=

# --- Search engine (optional; the site works fully on MySQL FULLTEXT without this — see
# docs/DEPLOY.md, "9c. Search engine"). Leave SCOUT_DRIVER unset to keep using FULLTEXT; set it
# only once a Meilisearch server is actually running at MEILISEARCH_HOST, then run:
#   php artisan scout:sync-index-settings && php artisan scout:import "App\Models\Listing"
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
